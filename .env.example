# ==============================================================================
# HỆ THỐNG QUẢN LÝ BẢN QUYỀN PHẦN MỀM TRƯỜNG HỌC (SALM)
# TẬP TIN CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================

# 1. CẤU HÌNH KẾT NỐI CƠ SỞ DỮ LIỆU CLOUD POSTGRESQL (NEON SERVERLESS)
# DATABASE_URL: Chuỗi kết nối qua Connection Pooler (khuyến nghị cho Vercel Serverless / Runtime)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Chuỗi kết nối Direct không qua Pooler (dùng cho Prisma CLI: db push, migrations)
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. KHÓA BÍ MẬT MÃ HÓA AES-256-CBC CHO LICENSE KEY (Chuỗi bí mật 32 ký tự hoặc hex)
AES_SECRET_KEY="salm_aes_secret_key_32_chars!!"

# 3. KHÓA BÍ MẬT XÁC THỰC PHIÊN LÀM VIỆC JSON WEB TOKEN (JWT)
JWT_SECRET="salm_jwt_super_secret_key_2026_graduation_thesis"

# 4. KHÓA BẢO MẬT API CRON JOB TRÊN VERCEL (Kích hoạt quét hạn tự động)
CRON_SECRET="salm_cron_secret_token_secure_2026"

# 5. CẤU HÌNH GỬI EMAIL CẢNH BÁO TỰ ĐỘNG (NODEMAILER QUA GMAIL SMTP)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-character-gmail-app-password"
EMAIL_FROM="SALM System <your-email@gmail.com>"
